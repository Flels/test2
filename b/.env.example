# Server
PORT=3000
FRONTEND_URL=http://localhost:4200

# Datenbank (muss zum CREATE USER in webshop.sql passen)
DB_HOST=localhost
DB_PORT=3306
DB_USER=webshop
DB_PASSWORD=webshop123
DB_NAME=webshop

# Geheimer Schlüssel für JWT (Login-Token) – in Produktion lang & zufällig!
JWT_SECRET=bitte-aendern-langer-zufaelliger-string

# E-Mail-Versand (leer lassen = Mail wird nur in der Konsole ausgegeben)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Webshop <shop@example.com>"
